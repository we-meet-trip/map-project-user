# map-project-user 환경변수 예시. 복사해 .env 로 쓰고, 값은 직접 채운다(이 파일에는 값을 넣지 않는다).
# 통합 실행(Docker Compose)은 map-project-infra 의 .env.example 을 쓴다. 이 파일은 단독 실행용이다.
#
# **아래 기본값은 로컬 실행용이다. 외부에 열기 전에 반드시 USER_AUTH_ENFORCED=true 로 켜고
# JWT 키·내부 서비스 토큰·CORS 출처를 설정한다(SECURITY.md).**
#
# 각 줄 위의 '기본값' 은 비워 두었을 때 코드가 쓰는 값이다. '기본값 없음' 은 빈 값이 기본이라는 뜻이고,
# 비었을 때의 동작은 src/main/resources/application.yml 의 설명을 본다. 예: 카카오 로그인·https 초대 링크는
# 꺼지고, Redis 비밀번호는 인증 없이 붙으며, 좌표 봉투 열쇠·저장 암호화 키는 비면 기동을 멈춘다.

# ---- 데이터베이스·Redis 연결 ----
# 기본값: postgres
MAP_PROJECT_POSTGRES_HOST=
# 기본값: 5432
MAP_PROJECT_POSTGRES_PORT=
# 기본값: map
MAP_PROJECT_POSTGRES_DB=
# 기본값: map_user_runtime
USER_DATABASE_USER=
# 기본값 없음
USER_DATABASE_PASSWORD=
# 기본값: redis
USER_REDIS_HOST=
# 기본값: 6379
USER_REDIS_PORT=
# 기본값 없음
MAP_PROJECT_REDIS_PASSWORD=

# ---- agent 호출 ----
# 기본값: http://agent:8000
MAP_PROJECT_AGENT_BASE_URL=
# 기본값: 60
USER_AGENT_TIMEOUT_SECONDS=
# 기본값 없음
MAP_PROJECT_INTERNAL_SERVICE_TOKEN=

# ---- hub 호출 ----
# 기본값: http://hub:8000
MAP_PROJECT_HUB_BASE_URL=
# 기본값: 5
USER_HUB_TIMEOUT_SECONDS=
# 기본값: 20
USER_HUB_DIRECTIONS_TIMEOUT_SECONDS=

# ---- 운영 콘솔 위임 경로 ----
# 기본값: 172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
USER_INTERNAL_TRUSTED_CIDRS=
# 기본값 없음
MAP_PROJECT_USER_ADMIN_INTERNAL_TOKEN=

# ---- 요청 한도 ----
# 기본값: 172.16.0.0/12,10.0.0.0/8,192.168.0.0/16,127.0.0.0/8
USER_RATELIMIT_TRUSTED_PROXIES=

# ---- trip 동기 생성 ----
# 기본값: 110
USER_TRIP_POLL_TIMEOUT_SECONDS=
# 기본값: 700
USER_TRIP_POLL_INTERVAL_MS=

# ---- 리뷰 요약 ----
# 기본값: 86400
USER_REVIEWS_SUMMARY_TTL_SECONDS=
# 기본값: false
USER_REVIEWS_PREWARM_ENABLED=
# 기본값: 1
USER_REVIEWS_PREWARM_POOL_SIZE=
# 기본값: 50
USER_REVIEWS_PREWARM_QUEUE_CAPACITY=
# 기본값: 7
USER_REVIEWS_PREWARM_MAX_PLACES=
# 기본값: 7
USER_REVIEWS_PREWARM_BATCH_SIZE=

# ---- 추천 ----
# 기본값: 3
USER_RESEARCH_DAILY_LIMIT=
# 기본값: 50000
USER_RECOMMEND_CACHE_BUDGET_ROUND_STEP=
# 기본값: 60
USER_RECOMMEND_CACHE_TIME_ROUND_STEP_MINUTES=
# 기본값: 3
USER_RECOMMEND_CACHE_REFRESH_EVERY_HITS=
# 기본값: 100
USER_RECOMMEND_CACHE_REFRESH_QUEUE_CAPACITY=

# ---- 도보 연결선(미완성 실험 기능, 기본 꺼짐) ----
# 기본값: false
USER_TRANSIT_WALK_ENABLED=

# ---- 날씨 변화 감시 ----
# 기본값: true
USER_WEATHER_WATCH_ENABLED=
# 기본값: 1800000
USER_WEATHER_WATCH_INTERVAL_MS=
# 기본값: 60000
USER_WEATHER_WATCH_INITIAL_DELAY_MS=

# ---- 추천 결과 스트림 ----
# 기본값: agent:jobs:done
MAP_PROJECT_STREAM_NAME=
# 기본값: bff-result
MAP_PROJECT_STREAM_GROUP=
# 기본값: user-1
USER_STREAM_CONSUMER=
# 기본값: agent:jobs:done:dlq
MAP_PROJECT_STREAM_DLQ=
# 기본값: 3
USER_STREAM_MAX_RETRY=
# 기본값: 2000
MAP_PROJECT_STREAM_MAXLEN=
# 기본값: 60000
USER_STREAM_MIN_IDLE_MS=
# 기본값: 30000
USER_STREAM_RECLAIM_INTERVAL_MS=
# 기본값: 64
USER_STREAM_RECLAIM_BATCH=
# 기본값: 6
USER_STREAMS_COMMAND_TIMEOUT_SEC=
# 기본값: 10000
USER_STREAMS_WATCHDOG_INTERVAL_MS=

# ---- Redis 논리 DB·TTL ----
# 기본값: 0
USER_REDIS_DB_DEFAULT=
# 기본값: 1
USER_REDIS_DB_BLACKLIST=
# 기본값: 2
MAP_PROJECT_REDIS_DB_STREAMS=
# 기본값: 3
USER_REDIS_DB_COUNTERS=
# 기본값: 3
MAP_PROJECT_REDIS_DB_RATELIMIT=
# 기본값: 4
USER_REDIS_DB_DRAFTS=
# 기본값: 5
USER_REDIS_DB_CHAT=
# 기본값: 6
USER_REDIS_DB_CACHE=
# 기본값: 3600
USER_REDIS_DRAFT_TTL_SECONDS=
# 기본값: 604800
USER_REDIS_CACHE_TTL_SECONDS=
# 기본값: 3600
USER_REDIS_CACHE_LINK_TTL_SECONDS=

# ---- 채팅 ----
# 기본값: 10
USER_CHAT_MAX_PARTICIPANTS=
# 기본값: 7
USER_CHAT_EXPIRY_GRACE_DAYS=
# 기본값: 50
USER_CHAT_HISTORY_PAGE_SIZE=
# 기본값 없음
USER_CHAT_INVITE_BASE_URL=
# 기본값: 2000
USER_CHAT_MAX_MESSAGE_LENGTH=
# 기본값: 20
USER_CHAT_SEND_RATE_LIMIT=
# 기본값: 10
USER_CHAT_SEND_RATE_WINDOW_SECONDS=
# 기본값: 10
USER_CHAT_INVITE_RATE_LIMIT=
# 기본값: 60
USER_CHAT_INVITE_RATE_WINDOW_SECONDS=
# 기본값: 7
USER_CHAT_INVITE_TTL_DAYS=
# 기본값: 30
USER_CHAT_INVITE_PREVIEW_RATE_LIMIT=
# 기본값: 60
USER_CHAT_INVITE_PREVIEW_RATE_WINDOW_SECONDS=
# 기본값: chat:broadcast
USER_CHAT_BROADCAST_CHANNEL=
# 기본값: /ws/chat
USER_CHAT_WS_ENDPOINT=
# 기본값: 60000
USER_CHAT_EXPIRY_SWEEP_INTERVAL_MS=

# ---- JWT ----
# 기본값 없음
USER_JWT_PRIVATE_KEY=
# 기본값 없음
USER_JWT_PUBLIC_KEY=
# 기본값: 3600
USER_JWT_ACCESS_TTL=
# 기본값: 2592000
USER_JWT_REFRESH_TTL=

# ---- 카카오 로그인(앱 번호를 주면 켜진다) ----
# 기본값 없음
USER_KAKAO_APP_ID=
# 기본값 없음
USER_KAKAO_TOKEN_INFO_URI=
# 기본값: https://kapi.kakao.com/v2/user/me
USER_KAKAO_USER_INFO_URI=

# ---- CORS ----
# 기본값: *
USER_CORS_ALLOWED_ORIGINS=

# ---- 인가 시행 ----
# 기본값: false
USER_AUTH_ENFORCED=

# ---- 저장 암호화·좌표 봉투 ----
# 기본값: true
USER_LOCATION_ENC_ENABLED=
# 기본값 없음
USER_LOCATION_ENC_ACTIVE_KID=
# 기본값 없음
USER_LOCATION_ENC_KEYS=
# 기본값 없음
MAP_PROJECT_LOCATION_WIRE_KEY=
# 기본값: 3600
USER_LOCATION_WIRE_MAX_AGE_SECONDS=

# ---- 주변 장소 ----
# 기본값: 1000
USER_NEARBY_RADIUS_METERS=
# 기본값: 10
USER_NEARBY_SIZE=

# ---- 학습 수집·내보내기(기본 꺼짐) ----
# 기본값: false
MAP_PROJECT_TRAINING_CAPTURE_ENABLED=
# 기본값: false
USER_TRAINING_EXPORT_APPROVED=
# 기본값: false
USER_TRAINING_EXPORT_ENABLED=
# 기본값 없음
USER_TRAINING_EXPORT_USER_REF_SALT=
# 기본값: true
USER_TRAINING_EXPORT_EXCLUDE_TEST_ACCOUNTS=
# 기본값: example.com,test.com,map.test
USER_TRAINING_EXPORT_TEST_EMAIL_DOMAINS=
# 기본값 없음
USER_TRAINING_EXPORT_OUTPUT_DIR=
# 기본값: 500
USER_TRAINING_EXPORT_BATCH_SIZE=

# ---- 시험 계정 시더(기본 꺼짐) ----
# 기본값: false
USER_TESTER_SEED_ENABLED=
# 기본값 없음
USER_TESTER_SEED_PASSWORD=

# ---- 비전 호출 허가 ----
# 기본값 없음
MAP_PROJECT_VISION_INTERNAL_TOKEN=
# 기본값: 60
USER_VISION_DAILY_LIMIT=
